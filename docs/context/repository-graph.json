{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "aetheon-saas-repository-graph",
  "version": "1.0.0",
  "nodes": [
    { "id": "page.dashboard", "type": "page", "path": "src/app/page.tsx" },
    { "id": "page.grid", "type": "page", "path": "src/app/grid-intelligence/page.tsx" },
    { "id": "page.dsm", "type": "page", "path": "src/app/dsm/page.tsx" },
    { "id": "page.bess", "type": "page", "path": "src/app/bess/page.tsx" },
    { "id": "page.compliance", "type": "page", "path": "src/app/compliance/page.tsx" },
    { "id": "page.renewables", "type": "page", "path": "src/app/renewables/page.tsx" },
    { "id": "page.settings", "type": "page", "path": "src/app/settings/page.tsx" },
    { "id": "page.alerts", "type": "page", "path": "src/app/alerts/page.tsx" },
    { "id": "page.reports", "type": "page", "path": "src/app/reports/page.tsx" },
    { "id": "page.admin", "type": "page", "path": "src/app/admin/page.tsx" },

    { "id": "api.ingestion", "type": "api_route", "path": "src/app/api/ingestion/commit/route.ts" },
    { "id": "api.forecast", "type": "api_route", "path": "src/app/api/forecast/route.ts" },
    { "id": "api.dsm", "type": "api_route", "path": "src/app/api/dsm/route.ts" },
    { "id": "api.bess", "type": "api_route", "path": "src/app/api/bess/route.ts" },
    { "id": "api.compliance", "type": "api_route", "path": "src/app/api/compliance/route.ts" },
    { "id": "api.renewables", "type": "api_route", "path": "src/app/api/renewables/route.ts" },
    { "id": "api.reports_generate", "type": "api_route", "path": "src/app/api/reports/generate/route.ts" },
    { "id": "api.reports_download", "type": "api_route", "path": "src/app/api/reports/[id]/download/route.ts" },
    { "id": "api.alerts_ack", "type": "api_route", "path": "src/app/api/alerts/[id]/acknowledge/route.ts" },
    { "id": "api.billing_checkout", "type": "api_route", "path": "src/app/api/billing/checkout/route.ts" },
    { "id": "api.webhooks_razorpay", "type": "api_route", "path": "src/app/api/webhooks/razorpay/route.ts" },

    { "id": "guard.api", "type": "auth_guard", "path": "src/lib/auth/api-guard.ts" },
    { "id": "service.analytics", "type": "microservice", "path": "services/analytics/main.py" },
    { "id": "service.entitlements", "type": "service", "path": "src/features/entitlements/service.ts" },

    { "id": "rpc.commit_ingestion", "type": "rpc", "signature": "commit_ingestion_transaction" },
    { "id": "rpc.has_site_access", "type": "rpc", "signature": "has_site_access(UUID)" },
    { "id": "rpc.ack_alert", "type": "rpc", "signature": "acknowledge_alert_atomic" },
    { "id": "rpc.ack_dsm", "type": "rpc", "signature": "acknowledge_dsm_incident_atomic" },

    { "id": "table.organisations", "type": "table", "name": "organisations" },
    { "id": "table.sites", "type": "table", "name": "sites" },
    { "id": "table.site_access", "type": "table", "name": "site_access" },
    { "id": "table.interval_data_96", "type": "table", "name": "interval_data_96" },
    { "id": "table.grid_forecast_runs", "type": "table", "name": "grid_forecast_runs" },
    { "id": "table.grid_forecast_blocks", "type": "table", "name": "grid_forecast_blocks" },
    { "id": "table.dsm_incidents", "type": "table", "name": "dsm_incidents" },
    { "id": "table.dsm_evaluation_runs", "type": "table", "name": "dsm_evaluation_runs" },
    { "id": "table.bess_assets", "type": "table", "name": "bess_assets" },
    { "id": "table.bess_signal_runs", "type": "table", "name": "bess_signal_runs" },
    { "id": "table.regulatory_sources", "type": "table", "name": "regulatory_sources" },
    { "id": "table.compliance_obligations", "type": "table", "name": "compliance_obligations" },
    { "id": "table.alerts", "type": "table", "name": "alerts" },
    { "id": "table.report_records", "type": "table", "name": "report_records" },
    { "id": "table.audit_logs", "type": "table", "name": "audit_logs" },

    { "id": "test.adversarial", "type": "test_suite", "path": "tests/integration/adversarial_api.test.ts" },
    { "id": "test.rls", "type": "test_suite", "path": "tests/integration/supabase_rls.test.ts" },
    { "id": "test.audit", "type": "test_suite", "path": "tests/integration/audit_chaining.test.ts" },
    { "id": "test.authority_audit", "type": "test_suite", "path": "tests/integration/authority_and_auditability.test.ts" },
    { "id": "test.persistence", "type": "test_suite", "path": "tests/e2e/persistence_journey.spec.ts" },
    { "id": "test.demo_smoke", "type": "test_suite", "path": "tests/e2e/demo_smoke.spec.ts" }
  ],
  "edges": [
    { "from": "page.settings", "to": "api.ingestion", "relation": "submits_csv" },
    { "from": "api.ingestion", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.ingestion", "to": "rpc.commit_ingestion", "relation": "executes" },
    { "from": "rpc.commit_ingestion", "to": "table.interval_data_96", "relation": "writes" },
    { "from": "rpc.commit_ingestion", "to": "table.audit_logs", "relation": "writes" },

    { "from": "page.grid", "to": "api.forecast", "relation": "fetches" },
    { "from": "api.forecast", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.forecast", "to": "table.interval_data_96", "relation": "reads" },
    { "from": "api.forecast", "to": "service.analytics", "relation": "calls" },
    { "from": "api.forecast", "to": "table.grid_forecast_blocks", "relation": "writes" },

    { "from": "page.dsm", "to": "api.dsm", "relation": "fetches" },
    { "from": "api.dsm", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.dsm", "to": "table.interval_data_96", "relation": "reads" },
    { "from": "api.dsm", "to": "service.analytics", "relation": "calls" },
    { "from": "api.dsm", "to": "table.dsm_incidents", "relation": "writes" },
    { "from": "api.dsm", "to": "table.dsm_evaluation_runs", "relation": "writes" },
    { "from": "api.dsm", "to": "rpc.ack_dsm", "relation": "acknowledges" },

    { "from": "page.bess", "to": "api.bess", "relation": "fetches" },
    { "from": "api.bess", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.bess", "to": "table.bess_assets", "relation": "reads" },
    { "from": "api.bess", "to": "service.analytics", "relation": "calls" },
    { "from": "api.bess", "to": "table.bess_signal_runs", "relation": "writes" },

    { "from": "page.compliance", "to": "api.compliance", "relation": "fetches" },
    { "from": "api.compliance", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.compliance", "to": "table.regulatory_sources", "relation": "reads_approved_only" },
    { "from": "api.compliance", "to": "table.compliance_obligations", "relation": "reads" },

    { "from": "page.alerts", "to": "api.alerts_ack", "relation": "acknowledges" },
    { "from": "api.alerts_ack", "to": "guard.api", "relation": "authorizes" },
    { "from": "api.alerts_ack", "to": "rpc.ack_alert", "relation": "executes" },
    { "from": "rpc.ack_alert", "to": "table.alerts", "relation": "updates" },
    { "from": "rpc.ack_alert", "to": "table.audit_logs", "relation": "writes" },

    { "from": "page.reports", "to": "api.reports_generate", "relation": "requests" },
    { "from": "page.reports", "to": "api.reports_download", "relation": "downloads" },
    { "from": "api.reports_download", "to": "table.report_records", "relation": "reads" },

    { "from": "guard.api", "to": "rpc.has_site_access", "relation": "validates" },
    { "from": "guard.api", "to": "service.entitlements", "relation": "validates" },

    { "from": "test.adversarial", "to": "api.forecast", "relation": "tests" },
    { "from": "test.adversarial", "to": "api.dsm", "relation": "tests" },
    { "from": "test.adversarial", "to": "api.bess", "relation": "tests" },
    { "from": "test.adversarial", "to": "api.ingestion", "relation": "tests" },
    { "from": "test.adversarial", "to": "api.compliance", "relation": "tests" },
    { "from": "test.rls", "to": "table.sites", "relation": "tests_isolation" },
    { "from": "test.audit", "to": "table.audit_logs", "relation": "tests_chaining" },
    { "from": "test.persistence", "to": "page.dashboard", "relation": "tests_e2e" },
    { "from": "test.demo_smoke", "to": "page.dashboard", "relation": "tests_e2e" }
  ]
}
