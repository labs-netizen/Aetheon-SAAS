# Next.js Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Managed PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:15431
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Internal Python Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_TOKEN=your-analytics-service-token-placeholder

# Payment Provider (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-placeholder
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-placeholder

# Demo Mode Flag (Displays prominent DEMO DATA badges across UI)
NEXT_PUBLIC_DEMO_MODE=true
