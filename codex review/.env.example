# Next.js Application Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Managed PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Internal Python Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_TOKEN=internal-dev-secret-token

# Payment Provider (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret

# Demo Mode Flag (Displays prominent DEMO DATA badges across UI)
NEXT_PUBLIC_DEMO_MODE=true
